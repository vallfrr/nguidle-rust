# Unlocks the menus of a new game (conditions taken from ButtonShower.cs). Usage: step `do,dev/unlock.steps`.
set,Character.settings.tutorialOffForever,true
call,HoverTooltip.hideTutorialTooltip
set,Character.firstBossEver,false
set,Character.bossID,150
set,Character.highestBoss,150
set,Character.magic.capMagic,100000
set,Character.settings.pitUnlocked,true
set,Character.settings.inventoryOn,true
set,Character.settings.wandoos98On,true
set,Character.settings.yggdrasilOn,true
set,Character.settings.diggersOn,true
set,Character.settings.nguOn,true
set,Character.settings.beardsOn,true
set,Character.settings.beastOn,true
set,Character.settings.itopodOn,true
set,Character.res3.res3On,true
set,Character.hacks.hacksOn,true
set,Character.wishes.wishesOn,true
set,Character.cards.cardsOn,true
set,Character.cooking.unlocked,true
call,ButtonShower.updateButtons
w,10
